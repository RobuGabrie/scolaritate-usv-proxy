# USV VPN credentials
VPN_SERVER_IPorFQDN=vpn.usv.ro
VPN_PSK=USVL2TPKey#2018
VPN_USERNAME=your.name@student.usv.ro
VPN_PASSWORD=your_vpn_password

# App secret — generate with: openssl rand -base64 32
JWT_SECRET=

# Cloudflare Tunnel token — get from: Zero Trust → Networks → Tunnels → your tunnel → Configure
CLOUDFLARE_TUNNEL_TOKEN=
