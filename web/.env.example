# Public URL of the app — used for SEO metadata and OG images
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# USV VPN credentials (student account)
VPN_USERNAME=your.name@student.usv.ro
VPN_PASSWORD=your_vpn_password

# App secret — generate with: openssl rand -base64 32
JWT_SECRET=

# Cloudflare Tunnel token — get from: Zero Trust → Networks → Tunnels → your tunnel → Configure
CLOUDFLARE_TUNNEL_TOKEN=

# Grafana admin password — accessible at http://your-server:3001
GRAFANA_PASSWORD=
